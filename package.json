{
  "name": "sabatku-lessons",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Markdown source and static catalog publisher for SabatKu Sabbath School lessons",
  "scripts": {
    "validate": "node scripts/build-content.mjs --check",
    "build:content": "node scripts/build-content.mjs",
    "audit:aij-translations": "node scripts/audit-alive-in-jesus-translations.mjs",
    "test": "node --test tests/*.test.mjs",
    "preview:aij": "node scripts/build-content.mjs --preview-drafts"
  },
  "engines": {
    "node": ">=20"
  }
}
